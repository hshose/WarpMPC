+    def take_main_steps(self, solver_state, problem):
+        """Use static inner bounds while returning the exact iteration cap.
+
+        Main solves start with min(10, limit) iterations, then advance in
+        fixed-size blocks. Under vmap, a dynamic inner loop bound introduces
+        per-iteration masking and batch-wide termination reductions. Split
+        at the known final-block length instead, selecting that snapshot
+        only for the partial final block. Any computed tail is discarded.
+        Feasibility-polishing loops retain the general bounded helper.
+        """
+        startup = min(10, self.iteration_limit)
+        if self.iteration_limit <= startup:
+            return solver_state
+        frequency = self.termination_evaluation_frequency
+        tail = (self.iteration_limit - startup) % frequency
+        partial_state = jax.lax.fori_loop(
+            0, tail, lambda i, state: self.take_step(state, problem), solver_state
+        )
+        full_state = jax.lax.fori_loop(
+            tail, frequency,
+            lambda i, state: self.take_step(state, problem), partial_state
+        )
+        return jax.lax.cond(
+            solver_state.num_iterations + frequency > self.iteration_limit,
+            lambda: partial_state,
+            lambda: full_state,
+        )
